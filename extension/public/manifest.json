{
  "manifest_version": 3,
  "name": "ブックマークを保存する拡張機能",
  "version": "0.10.0",
  "description": "開いているページをブックマークします",
  "permissions": ["tabs", "storage", "activeTab"],
  "action": {
    "default_popup": "index.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icon-default.png",
    "48": "icon-default.png",
    "128": "icon-default.png"
  }
}
