{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["chrome", "@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["server", "shared"],
  "exclude": ["shared/components/ui"]
}
